{
  "name": "vue-legal-link-graph",
  "version": "0.1.0",
  "description": "BlueLab link graph: turns annotated provisions and their typed links into a document-set@1 graph. Emits the graph and never calls an API itself.",
  "type": "module",
  "main": "./dist/vue-legal-link-graph.umd.cjs",
  "module": "./dist/vue-legal-link-graph.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-legal-link-graph.js",
      "require": "./dist/vue-legal-link-graph.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "legal",
    "graph",
    "bluelab"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0"
  }
}
